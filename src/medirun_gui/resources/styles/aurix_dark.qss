* {
    color: #eef5fb;
    font-family: "Noto Sans KR", "Segoe UI", sans-serif;
    font-size: 14px;
    background-color: transparent;
}

QMainWindow, QWidget#dashboardRoot, QDialog {
    background-color: #040a13;
}

QFrame#pageShell {
    background-color: #08131f;
    border: 1px solid #173147;
}

QFrame#adminContent {
    background-color: #0b1624;
}

QFrame#sideNav {
    background-color: #0d1a28;
    border-right: 1px solid #173147;
}

QFrame#pageCanvas {
    background-color: #0b1622;
    border: 1px solid #1d3348;
    border-radius: 12px;
}

QFrame#contentPanel,
QFrame#metricCard {
    background-color: #0d1f30;
    border: 1px solid #1d3348;
    border-radius: 8px;
}

QFrame#loginCard {
    background-color: #102033;
    border: 1px solid #1c3b58;
    border-radius: 18px;
}

QFrame#loginPreviewPanel {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0a1c2a, stop:1 #102d41);
    border-right: 1px solid #173147;
}

QFrame#loginFormPanel {
    background-color: #08111d;
}

QLabel#brandLogo {
    background-color: transparent;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
}

QLabel#brandTitle {
    color: #f7fbff;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 2px;
}

QLabel#brandSubtitle {
    color: #4f89ad;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#sectionKicker,
QLabel#loginKicker {
    color: #2ed3eb;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
}

QLabel#pageTitle {
    color: #f5fbff;
    font-size: 24px;
    font-weight: 800;
}

QLabel#pageSubtitle,
QLabel#metricCaption,
QLabel#previewHeroBody,
QLabel#missionLogLabel,
QLabel#loginSubtitle,
QLabel#loginStatus,
QLabel#demoHint {
    color: #7f9bb0;
    font-size: 12px;
}

QLabel#pageSubtitle[batteryKind="green"] {
    color: #4ade80;
    font-weight: 700;
}

QLabel#pageSubtitle[batteryKind="amber"] {
    color: #fbbf24;
    font-weight: 700;
}

QLabel#pageSubtitle[batteryKind="red"] {
    color: #f87171;
    font-weight: 700;
}

QLabel#pageSubtitle[batteryKind="muted"] {
    color: #7f9bb0;
    font-weight: 600;
}

QLabel#loginErrorLabel {
    color: #f87171;
    font-size: 11px;
    font-weight: 600;
}

QToolButton#passwordVisibilityButton {
    background: transparent;
    border: none;
    padding: 0;
}

QToolButton#passwordVisibilityButton:hover {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 15px;
}

QLabel#previewHeroTitle {
    color: #f6fbff;
    font-size: 52px;
    font-weight: 900;
}

QLabel#loginPreviewImage {
    background-color: transparent;
    min-width: 820px;
    min-height: 940px;
}

QLabel#metricTitle {
    color: #8eabbf;
    font-size: 11px;
    font-weight: 700;
}

QLabel#metricValue {
    color: #f6fbff;
    font-size: 22px;
    font-weight: 800;
}

QLabel#metricDot {
    color: #2ed3eb;
    font-size: 18px;
    font-weight: 900;
}

QLabel#panelTitle {
    color: #f5fbff;
    font-size: 16px;
    font-weight: 700;
}

QPushButton {
    background-color: #0f1c2a;
    border: 1px solid #1c3b58;
    border-radius: 10px;
    color: #dceefc;
    padding: 0 12px;
    min-height: 38px;
    font-weight: 700;
}

QPushButton:hover {
    background-color: #15283b;
    border-color: #2ed3eb;
    color: #f6fcff;
}

QPushButton#sidebarButton,
QPushButton#sidebarButtonActive {
    text-align: left;
    min-height: 42px;
    padding: 0 14px;
    background-color: transparent;
    border: 1px solid transparent;
    color: #90a9bc;
}

QPushButton#sidebarButtonActive {
    background-color: #123248;
    border-color: #1ec5dd;
    color: #eaf8ff;
}

QPushButton#sidebarButton:hover {
    background-color: #11283a;
    border-color: #2ed3eb;
    color: #edf9ff;
    padding-left: 18px;
}

QPushButton#sidebarButtonActive:hover {
    background-color: #17415d;
    border-color: #55e0f0;
    color: #ffffff;
}

QLabel#sidebarUserName {
    color: #dceefc;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#primaryCtaButton {
    min-height: 42px;
    background-color: #32c8de;
    border: none;
    color: #07111b;
    font-weight: 900;
}

QPushButton#primaryCtaButton:hover {
    background-color: #52d7ea;
    color: #041019;
}

QPushButton#inlineGhostButton {
    min-height: 38px;
}

QPushButton#inlineGhostButton:hover {
    background-color: #173047;
    border-color: #39d3eb;
}

QLineEdit {
    min-height: 42px;
    background-color: #0b1624;
    border: 1px solid #1c3b58;
    border-radius: 10px;
    padding: 0 14px;
    color: #f1f8fe;
}

QLineEdit:focus {
    border-color: #2ed3eb;
}

QLineEdit#compactField {
    padding: 0 6px;
    font-size: 11px;
}

QComboBox {
    min-height: 42px;
    background-color: #0b1624;
    border: 1px solid #1c3b58;
    border-radius: 10px;
    padding: 0 14px;
    color: #f1f8fe;
}

QComboBox:hover,
QComboBox:focus {
    border-color: #2ed3eb;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: #102033;
    border: 1px solid #1c3b58;
    color: #eef5fb;
    selection-background-color: #17415d;
    selection-color: #ffffff;
}

QFrame#secureBand {
    background-color: transparent;
    border: 1px solid #24506b;
    border-radius: 14px;
}

QLabel#secureTag {
    background-color: #133228;
    border: 1px solid #1d8f68;
    border-radius: 12px;
    color: #4cdc92;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 800;
}

QLabel#secureLiveTag {
    color: #edf8ff;
    font-size: 12px;
    font-weight: 700;
}

QTableWidget {
    background-color: transparent;
    border: none;
    gridline-color: #173147;
}

QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget::item {
    padding: 4px 6px;
    border-bottom: 1px solid #16293c;
    color: #a8bdd2;
}

QListWidget::item:selected {
    background-color: #0e2438;
    border: 1px solid #2a5f7d;
    border-radius: 6px;
    color: #eaf8ff;
}

QTableWidget::item {
    padding: 10px;
    border-bottom: 1px solid #173147;
}

QHeaderView::section {
    background-color: transparent;
    color: #7fa3ba;
    border: none;
    border-bottom: 1px solid #173147;
    padding: 8px 6px;
    font-weight: 700;
}

QFrame#healthBar {
    border-radius: 4px;
    border: none;
    background-color: #1f3344;
}

QLabel#healthLabel,
QLabel#healthValue {
    color: #edf8ff;
    font-size: 12px;
}

QFrame#sectionDivider {
    background-color: #173147;
    border: none;
}

/* ---- Dashboard shell (headerBar / sideNav / mapView) ---- */

QFrame#headerBar {
    background-color: #0d1a29;
    border: 1px solid #1d3348;
    border-radius: 8px;
}

QFrame#mapViewCanvas {
    background-color: #0d1f30;
    border: 1px solid #1d3348;
    border-radius: 8px;
}

QLabel#mapCaption,
QLabel#mapOverlayText {
    color: #7d93aa;
    font-size: 10px;
}

QLabel#waypointMapOverlayText {
    color: #eef5fb;
    font-size: 10px;
    background-color: rgba(4, 10, 19, 190);
    border-radius: 4px;
    padding: 3px 7px;
}

QPushButton#mapToggleChip {
    min-height: 22px;
    padding: 0 9px;
    background-color: #0b1622;
    border: 1px solid #2a4a66;
    border-radius: 6px;
    color: #a8bdd2;
    font-size: 10px;
    font-weight: 600;
}

QPushButton#mapToggleChip:hover {
    border-color: #39c5e0;
    color: #eef5fb;
}

/* ---- Status badges (kind: green / cyan / amber / red / muted) ---- */

QLabel[badgeKind="green"] {
    background-color: #0f2e22;
    border: 1px solid #1d5c3f;
    color: #4ade80;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 10px;
    font-weight: 700;
}

QLabel[badgeKind="cyan"] {
    background-color: #12283c;
    border: 1px solid #2a5f7d;
    color: #39c5e0;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 10px;
    font-weight: 700;
}

QLabel[badgeKind="amber"] {
    background-color: #332508;
    border: 1px solid #6b4e12;
    color: #fbbf24;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 10px;
    font-weight: 700;
}

QLabel[badgeKind="red"] {
    background-color: #3d1220;
    border: 1px solid #7c2438;
    color: #f87171;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 10px;
    font-weight: 700;
}

QLabel[badgeKind="muted"] {
    background-color: #12283c;
    border: 1px solid #1d3348;
    color: #7d93aa;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 10px;
    font-weight: 700;
}

/* ---- Emergency stop ---- */

QPushButton#estopButton {
    min-height: 30px;
    padding: 0 14px;
    background-color: #3d1220;
    border: 1px solid #7c2438;
    color: #f87171;
    font-weight: 700;
}

QPushButton#estopButton:hover {
    background-color: #4a1626;
    border-color: #ff6e92;
    color: #ffd5df;
}

QPushButton#dangerFilledButton {
    background-color: #7c2438;
    border: none;
    color: #fecdd3;
    font-weight: 700;
}

QPushButton#dangerFilledButton:hover {
    background-color: #93293f;
}

/* 사용자/로봇 관리 테이블 행 안에 들어가는 삭제류 버튼 전용 — 기본
   QPushButton의 min-height:38px를 그대로 물려받으면 테이블 행 높이보다
   버튼이 커져버려서, 테이블 행에 맞는 낮은 높이로 따로 잡는다. */
QPushButton#tableRowDangerButton {
    min-height: 20px;
    max-height: 20px;
    padding: 0 10px;
    background-color: #7c2438;
    border: none;
    border-radius: 6px;
    color: #fecdd3;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#tableRowDangerButton:hover {
    background-color: #93293f;
}

QPushButton#amberFilledButton {
    background-color: #332508;
    border: 1px solid #6b4e12;
    color: #fbbf24;
    font-weight: 700;
}

QPushButton#amberFilledButton:hover {
    background-color: #3d2c0a;
    border-color: #fbbf24;
}

QPushButton#cyanOutlineButton {
    min-height: 34px;
    background-color: transparent;
    border: 1px solid #2a5f7d;
    color: #39c5e0;
    font-weight: 700;
}

QPushButton#cyanOutlineButton:hover {
    background-color: #0e2438;
    border-color: #39c5e0;
}

QPushButton#cyanChipButton {
    min-height: 26px;
    padding: 0 12px;
    font-size: 11px;
    font-weight: 700;
    background-color: #0e2438;
    border: 1px solid #2a5f7d;
    border-radius: 6px;
    color: #39c5e0;
}

QPushButton#cyanChipButton:hover {
    background-color: #123049;
    border-color: #39c5e0;
}

/* ---- Recording pause/resume (live control camera bar) ---- */

QPushButton#pauseChipButton {
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
    font-size: 15px;
    font-weight: 700;
    background-color: #332508;
    border: 1px solid #6b4e12;
    border-radius: 17px;
    color: #fbbf24;
}

QPushButton#pauseChipButton:hover {
    background-color: #3d2c0a;
    border-color: #fbbf24;
}

QPushButton#resumeChipButton {
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
    font-size: 15px;
    font-weight: 700;
    background-color: #3d1220;
    border: 1px solid #7c2438;
    border-radius: 17px;
    color: #f87171;
}

QPushButton#resumeChipButton:hover {
    background-color: #4a1626;
    border-color: #ff6e92;
}

QPushButton#ghostChipButton {
    min-height: 26px;
    padding: 0 12px;
    font-size: 11px;
    font-weight: 700;
    background-color: transparent;
    border: 1px solid #2a4a66;
    border-radius: 6px;
    color: #7d93aa;
}

QPushButton#ghostChipButton:hover {
    background-color: #11283a;
    border-color: #39c5e0;
    color: #eef5fb;
}

QFrame#warningBanner {
    background-color: #332508;
    border: 1px solid #6b4e12;
    border-radius: 8px;
}

QFrame#tabSwitcher {
    background-color: transparent;
    border: none;
}

QPushButton#tabButton,
QPushButton#tabButtonActive {
    min-height: 38px;
    padding: 0 20px;
    font-size: 13px;
    font-weight: 700;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #7d93aa;
}

QPushButton#tabButtonActive {
    background-color: #12283c;
    border-color: #2a5f7d;
    color: #39c5e0;
}

QPushButton#tabButton:hover {
    color: #eaf8ff;
}

QPushButton#routeChip,
QPushButton#routeChipActive {
    min-height: 24px;
    padding: 0 10px;
    font-size: 10px;
    font-weight: 700;
    border-radius: 10px;
    background-color: #0b1622;
    border: 1px solid #1d3348;
    color: #a8bdd2;
}

QPushButton#routeChipActive {
    background-color: #0e2438;
    border-color: #2a5f7d;
    color: #39c5e0;
}

/* ---- Mission stepper (LiveControlPage) ---- */

QLabel[stepState="done"] {
    background-color: #39c5e0;
    border: none;
    border-radius: 8px;
    color: #062633;
    font-weight: 800;
    qproperty-alignment: AlignCenter;
}

QLabel[stepState="active"] {
    background-color: #39c5e0;
    border: 3px solid #12283c;
    border-radius: 8px;
}

QLabel[stepState="pending"] {
    background-color: transparent;
    border: 2px solid #2a4a66;
    border-radius: 8px;
}

QLabel[stepState="failed"] {
    background-color: #f87171;
    border: none;
    border-radius: 8px;
    color: #3d1220;
    font-weight: 800;
    qproperty-alignment: AlignCenter;
}

QLabel[stepState="cancelled"] {
    background-color: #fbbf24;
    border: none;
    border-radius: 8px;
    color: #332508;
    font-weight: 800;
    qproperty-alignment: AlignCenter;
}

QFrame#stepConnectorDone {
    background-color: #39c5e0;
    border: none;
}

QFrame#stepConnectorPending {
    background-color: #1d3348;
    border: none;
}

/* ---- Cards ---- */

QFrame#anomalyCard {
    background-color: #1a0f18;
    border: 1px solid #7c2438;
    border-radius: 10px;
}

QFrame#callQueueCard {
    background-color: #0e2438;
    border: 1px solid #2a5f7d;
    border-radius: 10px;
}

/* Qt 스타일시트가 적용된 QPushButton은 setFixedSize()를 줘도 내부적으로
   글자 폭(sizeFromContents)에 따라 다시 커질 수 있다 — "↺"/"↻"는 원형
   화살표라 "▲"/"▼" 삼각형보다 글리프 자체가 넓어서 좌우 버튼만 실제로
   더 넓게 렌더링되던 원인이 이것. min/max-width를 양쪽 다 못박아 글자
   내용과 무관하게 4방향 버튼이 항상 같은 38px 정사각형이 되게 한다.
   (아이콘은 그대로 유지)
*/
QPushButton#directionPadButton {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    padding: 0;
    background-color: #0d1f30;
    border: 1px solid #2a4a66;
    border-radius: 9px;
    color: #dceefc;
    font-size: 16px;
    font-weight: 600;
}

QPushButton#directionPadButton:hover {
    background-color: #12283c;
    border-color: #39c5e0;
    color: #7fe3f4;
}

/* 정지는 방향 버튼과 같은 사각형이면 "네모 4개 사이에 낀 또 다른 네모"로
   묻혀 보인다. 원형 + 빨강으로 눌러야 할 때 한눈에 띄게 분리한다. */
QPushButton#directionPadStopButton {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    padding: 0;
    background-color: #7c2438;
    border: 1px solid #93293f;
    border-radius: 19px;
    color: #fecdd3;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#directionPadStopButton:hover {
    background-color: #93293f;
    border-color: #f87171;
}

/* ---- Timeline / progress tracks ---- */

QFrame#trackBase {
    background-color: #12283c;
    border: none;
    border-radius: 2px;
}

QFrame#trackFillCyan {
    background-color: #39c5e0;
    border: none;
    border-radius: 2px;
}
